/// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define custom output path for generated Prisma Client
generator client {
  provider = "prisma-client-js"
}

// --- Model untuk Pengguna ---
// Model ini menyimpan data akun pengguna yang mendaftar melalui formulir karir
model User {
  id        String   @id @default(cuid())
  email     String   @unique // Email harus unik untuk setiap pengguna
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relasi: Satu user bisa memiliki banyak lamaran karir
  karirApplications Karir[]
}

// --- Model untuk Program Kursus ---
model Program {
  id          String @id @default(cuid())
  name        String
  category    String
  description String
  price       Int
  duration    String
  features    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relasi ke model lain
  pendaftarans Pendaftaran[]
  pengajars    PengajarProgram[]
}

// --- Model untuk Data Pengajar ---
model Pengajar {
  id           String @id @default(cuid())
  name         String
  photo        String?
  qualification String
  specialization String
  experience   String
  email        String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relasi ke model lain
  programs PengajarProgram[]
}

// --- Model Tabel Penghubung (Junction Table) antara Pengajar dan Program ---
model PengajarProgram {
  id         String @id @default(cuid())
  pengajarId String
  programId  String
  
  pengajar Pengajar @relation(fields: [pengajarId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

// --- Model untuk Testimoni Siswa ---
model Testimoni {
  id        String @id @default(cuid())
  name      String
  role      String
  content   String
  rating    Int
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Model untuk Data Pendaftaran Siswa Baru ---
model Pendaftaran {
  id                   String @id @default(cuid())
  namaPanggilan        String
  namaLengkap          String
  jenisKelamin         String
  asalSekolah          String
  kelas                String
  kurikulum            String
  noHpOrangTua         String
  noHpSiswa            String?
  programId            String
  mataPelajaran        String
  jumlahSesi           Int
  status               String @default("pending")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  // Relasi ke model Program
  program Program @relation(fields: [programId], references: [id])
}

// --- Model untuk Pesan dari Formulir Kontak ---
model Kontak {
  id        String @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Model untuk Lamaran Karir ---
model Karir {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  position   String
  experience String?
  education  String?
  message    String?
  resume     String? // Path atau URL file CV
  userId     String?  // Foreign key ke tabel User (opsional)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relasi ke model User
  user User? @relation(fields: [userId], references: [id])
}